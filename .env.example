# ==========================================
# Video Downloader Server Configuration
# ==========================================

# Port Server
PORT=3000

# ------------------------------------------
# SOLUSI 1: PROXY CONFIGURATION
# ------------------------------------------
# Single Proxy URL (misal: http://user:pass@1.2.3.4:8080 atau socks5://1.2.3.4:1080)
PROXY_URL=

# Multiple Proxies (dipisah koma untuk rotation)
# PROXY_LIST=http://proxy1:8080,http://proxy2:8080,http://proxy3:8080

# ------------------------------------------
# SOLUSI 2: COOKIES CONFIGURATION
# ------------------------------------------
# Path ke file cookies.txt (Netscape format)
# Jika dikosongkan, server otomatis mencari 'cookies.txt' atau 'server/cookies.txt'
COOKIE_PATH=

# ------------------------------------------
# SOLUSI 5: CONCURRENCY & RATE LIMITING
# ------------------------------------------
# Maksimal download simultan bersamaan (default: 4)
MAX_CONCURRENT_DOWNLOADS=4

# Maksimal request per menit per IP (default: 30)
RATE_LIMIT_PER_MIN=30

# ------------------------------------------
# SOLUSI 7: YOUTUBE BOT GUARD / PO TOKEN
# ------------------------------------------
# Proof of Origin (PO) Token untuk YouTube (jika menggunakan IP server cloud)
YT_PO_TOKEN=
YT_VISITOR_DATA=
